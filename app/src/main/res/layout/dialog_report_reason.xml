<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1E1E1E">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/report_title"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/rg_report_reasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rb_opt_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_opt_1"
            android:textColor="#DDDDDD"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/rb_opt_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_opt_2"
            android:textColor="#DDDDDD"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/rb_opt_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_opt_3"
            android:textColor="#DDDDDD"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/rb_opt_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_opt_4"
            android:textColor="#DDDDDD"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/rb_opt_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_opt_5"
            android:textColor="#DDDDDD"
            android:layout_marginBottom="8dp" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="end">

        <Button
            android:id="@+id/btn_cancel_report"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancel"
            android:textColor="#888888" />

        <Button
            android:id="@+id/btn_submit_report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_submit"
            android:enabled="false"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginStart="16dp" />
    </LinearLayout>

</LinearLayout>
