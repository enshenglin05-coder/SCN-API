<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 深色底 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#080A12"/>
        </shape>
    </item>
    <!-- 彩色磨砂光暈 -->
    <item android:left="18dp"
          android:top="18dp"
          android:right="18dp"
          android:bottom="18dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="45%"
                android:gradientRadius="75%"
                android:startColor="#FFFF0040"
                android:centerColor="#FF00E5FF"
                android:endColor="#FF8A00FF"/>
        </shape>
    </item>
</layer-list>